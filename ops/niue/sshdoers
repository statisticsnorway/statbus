# /etc/sshdoers — statbus niue CI allowlist
#
# THIS FILE IS THE SOURCE. It is installed to /etc/sshdoers by Stage 8 of
# ops/setup-ubuntu-lts-24.sh, byte for byte, and the stage publishes a
# world-readable /etc/sshdoers.sha256 beside it. The release preflight compares
# that hash against this file and REFUSES TO CUT A RELEASE if they differ, so
# the live inbound-command policy is provably the reviewed one (STATBUS-259).
#
# So: change the fleet's CI access by editing THIS file in a reviewed commit and
# re-running the stage. Do not edit /etc/sshdoers on the host — the next
# preflight would catch it, and until then the fleet's access policy would be
# something nobody reviewed.
#
# It previously said "Managed by hand; see tmp/niue-sshdoers in the statbus repo
# for a copy" — pointing at a path that no longer exists, which is how this copy
# came to be treated as a souvenir rather than a source.
#
# Originally generated 2026-04-15.

# Abstract hex-digit runs (needed for the 40-char SHA in pg_regress).
# A '#' in a stored command matches any hex digit at runtime.
match hexdigits

# Log to syslog.
syslog auth

#
# Deploy users — invoked by .github/workflows/deploy-to-<slot>.yaml via raw ssh.
# Command shape: `cd ~/statbus && ./sb upgrade apply-latest`
#
# statbus_demo's apply-latest access is NOT the retired deploy-to-demo.yaml/
# master-to-demo.yaml push button (that door is dead, STATBUS-244a). It is
# the door for STATBUS-248's scheduled auto-apply trigger: that workflow
# supplies the TIMING (a scheduled dispatch), and demo's own upgrade channel
# chooses the TARGET — the trigger still runs this exact command over ssh, so
# the allowlist entry stays.
#
statbus_dev: cd ~/statbus && ./sb upgrade apply-latest
statbus_demo: cd ~/statbus && ./sb upgrade apply-latest
statbus_ma: cd ~/statbus && ./sb upgrade apply-latest
statbus_ug: cd ~/statbus && ./sb upgrade apply-latest
statbus_et: cd ~/statbus && ./sb upgrade apply-latest
statbus_jo: cd ~/statbus && ./sb upgrade apply-latest

#
# Named-target apply — invoked by deploy-to-dev.yaml (STATBUS-259/260): the
# release chain now dispatches deploy-to-dev naming an exact candidate SHA,
# so the door must permit installing THAT commit rather than whatever the
# box's channel resolves as newest. `./sb upgrade apply <sha>` (STATBUS-258)
# is the general named-target verb; this is the one door permitted to
# invoke it with an argument. 40 '#' characters match the 40-hex commit SHA
# at runtime (via `match hexdigits`), same pattern as the ci-deploy-status.sh
# and pg_regress entries below. COEXISTS with statbus_dev's apply-latest
# entry above, deliberately: a workflow-file revert during the transition
# must not strand dev without any apply door. Removing apply-latest is a
# separate, later reviewed commit — not implied by adding this one.
#
statbus_dev: cd ~/statbus && ./sb upgrade apply ########################################

#
# Notify-all-clouds — invoked by notify-all-clouds.yaml via appleboy ssh-action.
# Command is the single byte-stable entrypoint line (STATBUS-123): the behavior
# lives in ~/statbus/ops/ci-notify.sh (evolves via git); only the PATH is pinned.
# One entry per user (sshdo requires it); identical command for all six
# (tcc removed, STATBUS-321 phase 4a — the box no longer exists).
#
statbus_dev: ~/statbus/ops/ci-notify.sh
statbus_demo: ~/statbus/ops/ci-notify.sh
statbus_ma: ~/statbus/ops/ci-notify.sh
statbus_ug: ~/statbus/ops/ci-notify.sh
statbus_et: ~/statbus/ops/ci-notify.sh
statbus_jo: ~/statbus/ops/ci-notify.sh

#
# pg_regress test runner — invoked by pg_regress.yaml via appleboy ssh-action.
# 40 '#' characters match a 40-char hex SHA at runtime (via `match hexdigits`).
#
statbus_test: cd statbus && git fetch origin && git checkout -- . && git checkout ######################################## && ./dev.sh continous-integration-test

#
# CI deploy-status poll — invoked by deploy-to-<slot>.yaml after the poke
# (STATBUS-170: green means CONVERGED, not merely scheduled). Same pattern as
# ci-notify above: only the PATH is pinned, the behavior lives in
# ~/statbus/ops/ci-deploy-status.sh (evolves via git). The 40 '#' characters
# match the deployed commit's 40-hex SHA at runtime (via `match hexdigits`).
# One entry per user (sshdo requires it); identical command for all FIVE —
# demo has none: deploy-to-demo.yaml was deleted (STATBUS-244a), so demo has
# no poll consumer. Adding one back would be a grant ADDITION, a separate
# reviewed decision, not implied by this reconcile. tcc was removed
# (STATBUS-321 phase 4a): the box no longer exists.
#
# FOUR OF THESE FIVE ARE CONDEMNED (ma, ug, et, jo): they serve
# deploy-to-<slot>.yaml workflows Wave D queues for deletion once channel-
# following is confirmed (STATBUS-244a's transitional note, STATBUS-248
# Wave D1). Captured here as still-live and still enforced — removal happens
# in its own reviewed step, never silently inside a reconcile.
#
statbus_dev: ~/statbus/ops/ci-deploy-status.sh ########################################
statbus_ma: ~/statbus/ops/ci-deploy-status.sh ########################################
statbus_ug: ~/statbus/ops/ci-deploy-status.sh ########################################
statbus_et: ~/statbus/ops/ci-deploy-status.sh ########################################
statbus_jo: ~/statbus/ops/ci-deploy-status.sh ########################################
github-runner: /usr/local/sbin/statbus-runner-health
