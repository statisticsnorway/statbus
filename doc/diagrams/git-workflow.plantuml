@startuml git-workflow
!define MANUAL_TRIGGER <color:blue>**Manual**</color>
!define AUTOMATIC_TRIGGER <color:green>**Automatic**</color>

skinparam backgroundColor #FEFEFE
skinparam rectangle {
    BackgroundColor<<Branch>> #E3F2FD
    BackgroundColor<<Candidate>> #FFF3E0
    BackgroundColor<<Service>> #E8F5E9
}

title StatBus Candidate and Channel Delivery

rectangle "Development" {
    rectangle "feature/xxx" as feature <<Branch>>
    rectangle "master" as master <<Branch>>
}

rectangle "Release" {
    rectangle "release candidate tag" as candidate <<Candidate>>
    rectangle "GitHub release\nassets + manifests" as release <<Candidate>>
    rectangle "release-fleet-orchestrator" as orchestrator <<Service>>
    rectangle "deploy-to-dev.yaml\n(named SHA input)" as dev_workflow <<Service>>
}

rectangle "Installations" {
    rectangle "dev.statbus.org\nautomatic canary" as dev <<Service>>
    rectangle "rune / Norway\nhuman canary" as norway <<Service>>
    rectangle "demo + country slots\nstable channel" as fleet <<Service>>
}

rectangle "Operator" as operator
rectangle "cloud.sh / sb upgrade" as tools <<Service>>

feature --> master : MANUAL_TRIGGER\nPR merge
master --> candidate : MANUAL_TRIGGER\ncut candidate
candidate --> release : AUTOMATIC_TRIGGER\npublish immutable artifacts
candidate --> orchestrator : AUTOMATIC_TRIGGER\nrun release evidence chain
orchestrator --> dev_workflow : AUTOMATIC_TRIGGER\nworkflow dispatch + commit SHA
dev_workflow --> dev : AUTOMATIC_TRIGGER\napply exact candidate
release --> norway : candidate offered on\nprerelease channel
release --> fleet : stable promotion becomes\navailable on stable channel
operator --> tools : MANUAL_TRIGGER
tools --> norway : schedule observed candidate
tools --> fleet : inspect, notify, or roll fleet

note bottom of release
  No deploy branch is a transport.
  Every installed target is a named candidate
  or a release discovered from the box's channel.
end note

@enduml
