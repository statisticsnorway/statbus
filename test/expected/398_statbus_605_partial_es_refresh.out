-- STATBUS-605: a partial establishment timeline refresh reads the timesegments
-- of its own units and produces the same rows as a full refresh.
--
-- public.timeline_establishment_refresh(p_unit_id_ranges) rebuilds
-- timeline_establishment for the named establishments; a NULL range rebuilds
-- all. Its row source, timeline_establishment_def_for(ids), filters both the
-- timesegments and the per-segment stats aggregate on the batch's unit ids, so
-- the work of one batch follows the batch, not the size of the register. On the
-- full BRREG register (823,767 establishments) the stats aggregate read every
-- establishment's timesegments up to the batch's highest id; over 92 real
-- refresh batches the establishment refresh took 54.7 s, and 16.9 s when only
-- the batch's rows were read.
--
-- The read check runs after ANALYZE and with enable_seqscan off: it asserts
-- that the filter on the batch's ids can drive an index scan, which is what
-- lets the planner read only those rows on a large table. Rows read are counted from
-- pg_stat_xact_user_tables, which reports this transaction's own reads.
--
-- Fixture: the Norwegian legal units and establishments over time (several
-- versions with stats, test/data/03_*) plus 2,000 single-version informal
-- establishments with an employees stat each, so that reading a small batch
-- through the (unit_type, unit_id) index is clearly the cheapest plan.
BEGIN;
\i test/setup.sql
\echo -- test/setup.sql output suppressed for cleaner test output
-- test/setup.sql output suppressed for cleaner test output
\set ECHO none
\echo -- test/setup.sql done, test output follows
-- test/setup.sql done, test output follows
\echo "Test 398 (STATBUS-605): a partial establishment refresh reads only its units"
"Test 398 (STATBUS-605): a partial establishment refresh reads only its units"
CALL test.set_user_from_email('test.admin@statbus.org');
\o /dev/null
\set ECHO none
INSERT INTO public.import_job (definition_id, slug, description, note, edit_comment)
SELECT (SELECT id FROM public.import_definition WHERE slug = 'legal_unit_source_dates'),
       'import_398_lu', 'Test 398 legal units over time', 'test/data/03_norwegian-legal-units-over-time.csv', 'Test 398';
\copy public.import_398_lu_upload(valid_from,valid_to,tax_ident,name,birth_date,death_date,physical_address_part1,physical_postcode,physical_postplace,physical_region_code,physical_country_iso_2,postal_address_part1,postal_postcode,postal_postplace,postal_region_code,postal_country_iso_2,primary_activity_category_code,secondary_activity_category_code,sector_code,legal_form_code,data_source_code) FROM 'test/data/03_norwegian-legal-units-over-time.csv' WITH (FORMAT csv, DELIMITER ',', QUOTE '"', HEADER true);
CALL worker.process_tasks(p_queue => 'import');
INSERT INTO public.import_job (definition_id, slug, description, note, edit_comment)
SELECT (SELECT id FROM public.import_definition WHERE slug = 'establishment_for_lu_source_dates'),
       'import_398_es', 'Test 398 establishments over time', 'test/data/03_norwegian-establishments-over-time.csv', 'Test 398';
\copy public.import_398_es_upload(valid_from, valid_to, tax_ident,legal_unit_tax_ident,name,birth_date,death_date,physical_address_part1,physical_postcode,physical_postplace,physical_region_code,physical_country_iso_2,postal_address_part1,postal_postcode,postal_postplace,postal_region_code,postal_country_iso_2,primary_activity_category_code,secondary_activity_category_code,data_source_code,unit_size_code,employees,turnover) FROM 'test/data/03_norwegian-establishments-over-time.csv' WITH (FORMAT csv, DELIMITER ',', QUOTE '"', HEADER true);
CALL worker.process_tasks(p_queue => 'import');
NOTICE:  sql_saga: disable_temporal_triggers left native temporal foreign keys enabled (they have no sql_saga triggers); they are DEFERRABLE, defer them in this transaction with: SET CONSTRAINTS public.activity_establishment_id_valid, public.activity_legal_unit_id_valid, public.contact_establishment_id_valid, public.contact_legal_unit_id_valid, public.establishment_legal_unit_id_valid, public.legal_relationship_influenced_id_valid, public.legal_relationship_influencing_id_valid, public.location_establishment_id_valid, public.location_legal_unit_id_valid, public.person_for_unit_establishment_id_valid, public.person_for_unit_legal_unit_id_valid, public.power_root_custom_root_legal_unit_id_valid, public.power_root_derived_root_legal_unit_id_valid, public.stat_for_unit_establishment_id_valid, public.stat_for_unit_legal_unit_id_valid DEFERRED
INSERT INTO public.enterprise (short_name, edit_by_user_id, edit_comment)
SELECT 'T398_' || n, (SELECT id FROM auth.user LIMIT 1), 'Test 398 enterprise ' || n
FROM generate_series(1, 2000) AS n;
INSERT INTO public.establishment (valid_from, name, enterprise_id, primary_for_enterprise, status_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, 'T398 unit ' || e.short_name, e.id, true,
       (SELECT id FROM public.status WHERE code = 'active' LIMIT 1), (SELECT id FROM auth.user LIMIT 1), 'Test 398'
FROM public.enterprise AS e
WHERE e.short_name LIKE 'T398\_%';
INSERT INTO public.stat_for_unit (stat_definition_id, valid_from, establishment_id, value_int, edit_by_user_id, edit_comment)
SELECT (SELECT id FROM public.stat_definition WHERE code = 'employees'), '2020-01-01'::date, es.id, 1 + es.id % 50,
       (SELECT id FROM auth.user LIMIT 1), 'Test 398'
FROM public.establishment AS es
WHERE es.name LIKE 'T398 unit %';
CALL worker.process_tasks(p_queue => 'analytics');
\echo

\echo "398.0 fixture: establishments, their timesegments and stats, and the timesegments of the units over time"
"398.0 fixture: establishments, their timesegments and stats, and the timesegments of the units over time"
SELECT (SELECT count(DISTINCT id) FROM public.establishment) AS establishments,
       (SELECT count(*) FROM public.timesegments WHERE unit_type = 'establishment') AS establishment_segments,
       (SELECT count(*) FROM public.stat_for_unit WHERE establishment_id IS NOT NULL) AS establishment_stats,
       (SELECT count(*) FROM public.timesegments AS t
         WHERE t.unit_type = 'establishment'
           AND t.unit_id IN (SELECT id FROM public.establishment WHERE name NOT LIKE 'T398 unit %')) AS segments_of_units_over_time;
 establishments | establishment_segments | establishment_stats | segments_of_units_over_time 
----------------+------------------------+---------------------+-----------------------------
           2001 |                   2010 |                2015 |                          10
(1 row)

CREATE TEMP TABLE full_refresh ON COMMIT DROP AS
SELECT * FROM public.timeline_establishment;
-- The batch: every establishment over time, and one of the single-version ones.
CREATE TEMP TABLE batch ON COMMIT DROP AS
SELECT DISTINCT es.id
FROM public.establishment AS es
WHERE es.name NOT LIKE 'T398 unit %' OR es.name = 'T398 unit T398_1';
SELECT public.array_to_int4multirange(array_agg(id ORDER BY id)) AS batch_ranges FROM batch \gset
DELETE FROM public.timeline_establishment WHERE unit_id IN (SELECT id FROM batch);
-- Statistics as on a loaded database, where the planner can choose the
-- (unit_type, unit_id) index for a filter on a few unit ids.
ANALYZE public.timesegments;
SET LOCAL enable_seqscan = off;
SELECT coalesce(seq_tup_read, 0) + coalesce(idx_tup_fetch, 0) AS rows_read_before
FROM pg_stat_xact_user_tables WHERE relid = 'public.timesegments'::regclass \gset
CALL public.timeline_establishment_refresh(p_unit_id_ranges => :'batch_ranges'::int4multirange);
SELECT coalesce(seq_tup_read, 0) + coalesce(idx_tup_fetch, 0) - :rows_read_before AS rows_read
FROM pg_stat_xact_user_tables WHERE relid = 'public.timesegments'::regclass \gset
RESET enable_seqscan;
\echo

\echo "398.1 the partial refresh read at most three passes over its own units' timesegments"
"398.1 the partial refresh read at most three passes over its own units' timesegments"
SELECT count(*) AS batch_segments,
       :rows_read <= 3 * count(*) AS reads_only_batch_segments
FROM public.timesegments AS t
WHERE t.unit_type = 'establishment' AND t.unit_id IN (SELECT id FROM batch);
 batch_segments | reads_only_batch_segments 
----------------+---------------------------
             11 | t
(1 row)

\echo

\echo "398.2 the partial refresh produced the full refresh's rows for its units"
"398.2 the partial refresh produced the full refresh's rows for its units"
SELECT (SELECT count(*) FROM full_refresh WHERE unit_id IN (SELECT id FROM batch)) AS expected_rows,
       (SELECT count(*) FROM public.timeline_establishment WHERE unit_id IN (SELECT id FROM batch)) AS refreshed_rows,
       (SELECT count(*) FROM (SELECT * FROM full_refresh EXCEPT ALL SELECT * FROM public.timeline_establishment) AS d) AS missing,
       (SELECT count(*) FROM (SELECT * FROM public.timeline_establishment EXCEPT ALL SELECT * FROM full_refresh) AS d) AS extra;
 expected_rows | refreshed_rows | missing | extra 
---------------+----------------+---------+-------
            11 |             11 |       0 |     0
(1 row)

CALL public.timeline_establishment_refresh(p_unit_id_ranges => NULL);
\echo

\echo "398.3 a full refresh (NULL range) reproduces every row"
"398.3 a full refresh (NULL range) reproduces every row"
SELECT (SELECT count(*) FROM full_refresh) AS expected_rows,
       (SELECT count(*) FROM public.timeline_establishment) AS refreshed_rows,
       (SELECT count(*) FROM (SELECT * FROM full_refresh EXCEPT ALL SELECT * FROM public.timeline_establishment) AS d) AS missing,
       (SELECT count(*) FROM (SELECT * FROM public.timeline_establishment EXCEPT ALL SELECT * FROM full_refresh) AS d) AS extra;
 expected_rows | refreshed_rows | missing | extra 
---------------+----------------+---------+-------
          2010 |           2010 |       0 |     0
(1 row)

-- A worker session refreshes many batches. After a few executions PostgreSQL
-- may switch a PL/pgSQL statement to a generic plan, built without the batch's
-- ids; force_generic_plan makes that happen at once. The refresh must still
-- read only its own units' timesegments.
ANALYZE public.timesegments;
SET LOCAL enable_seqscan = off;
SET LOCAL plan_cache_mode = force_generic_plan;
SELECT coalesce(seq_tup_read, 0) + coalesce(idx_tup_fetch, 0) AS rows_read_before
FROM pg_stat_xact_user_tables WHERE relid = 'public.timesegments'::regclass \gset
CALL public.timeline_establishment_refresh(p_unit_id_ranges => :'batch_ranges'::int4multirange);
SELECT coalesce(seq_tup_read, 0) + coalesce(idx_tup_fetch, 0) - :rows_read_before AS rows_read
FROM pg_stat_xact_user_tables WHERE relid = 'public.timesegments'::regclass \gset
RESET plan_cache_mode;
RESET enable_seqscan;
\echo

\echo "398.4 with a generic plan the partial refresh still reads only its own units' timesegments"
"398.4 with a generic plan the partial refresh still reads only its own units' timesegments"
SELECT count(*) AS batch_segments,
       :rows_read <= 3 * count(*) AS reads_only_batch_segments
FROM public.timesegments AS t
WHERE t.unit_type = 'establishment' AND t.unit_id IN (SELECT id FROM batch);
 batch_segments | reads_only_batch_segments 
----------------+---------------------------
             11 | t
(1 row)

ROLLBACK;
