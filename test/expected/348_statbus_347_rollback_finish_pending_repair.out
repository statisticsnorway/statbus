psql:migrations/20260903205636_statbus_347_rollback_finish_pending_column.up.sql:142: NOTICE:  STATBUS-347: 1 legacy ROLLBACK_FINISH_PENDING row(s) carried into rollback_finish_pending_at
END;
\echo -- The repair uses the most recent failed-transition logged_at and strips the prefix.
-- The repair uses the most recent failed-transition logged_at and strips the prefix.
