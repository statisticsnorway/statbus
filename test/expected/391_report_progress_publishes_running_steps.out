\echo '=== STATBUS-577: publish report steps before executing their handlers ==='
=== STATBUS-577: publish report steps before executing their handlers ===
BEGIN;
LOCK TABLE worker.tasks IN EXCLUSIVE MODE;
DELETE FROM worker.tasks WHERE true; -- test setup: start from an empty table
SET client_min_messages = warning;
-- Capture the production notifier's actual payloads without delivering events.
-- Explicit pg_catalog placement lets this transaction-local test schema observe
-- pg_notify calls. The schema, handler replacement and fixtures all roll back.
CREATE SCHEMA statbus_577_progress_test;
SET LOCAL search_path = statbus_577_progress_test, public, worker, pg_catalog;
CREATE TABLE progress_snapshots (
    seq bigint GENERATED ALWAYS AS IDENTITY,
    payload jsonb NOT NULL
);
CREATE TABLE handler_observations (
    command text NOT NULL,
    reports jsonb NOT NULL
);
CREATE FUNCTION statbus_577_progress_test.pg_notify(channel text, message text)
RETURNS void LANGUAGE plpgsql AS $pg_notify$
BEGIN
    IF channel = 'worker_status' THEN
        INSERT INTO progress_snapshots (payload) VALUES (message::jsonb);
    END IF;
END;
$pg_notify$;
CREATE PROCEDURE worker.observe_report_start_577(IN payload jsonb, INOUT p_info jsonb DEFAULT NULL)
LANGUAGE plpgsql AS $observe_report_start_577$
BEGIN
    INSERT INTO handler_observations (command, reports)
    SELECT observe_report_start_577.payload->>'command', phase
    FROM progress_snapshots AS snapshot,
         LATERAL jsonb_array_elements(snapshot.payload->'phases') AS phase
    WHERE phase->>'phase' = 'is_deriving_reports'
    ORDER BY snapshot.seq DESC LIMIT 1;
    p_info := '{}'::jsonb;
END;
$observe_report_start_577$;
UPDATE worker.command_registry
SET handler_procedure = 'worker.observe_report_start_577', before_procedure = NULL, after_procedure = NULL
WHERE command IN ('statistical_unit_facet_reduce', 'statistical_history_facet_delta_reduce');
INSERT INTO worker.tasks (id, command, payload, state, parent_id, depth, child_mode, priority) VALUES
(57701, 'collect_changes', '{}', 'waiting', NULL, 0, 'serial', 1),
(57702, 'derive_units_phase', '{}', 'waiting', 57701, 1, 'serial', 2),
(57703, 'derive_reports_phase', '{}', 'pending', 57701, 1, 'serial', 3);
CALL worker.notify_task_progress();
SELECT phase->>'active' AS active, phase->>'pending' AS pending
FROM progress_snapshots AS snapshot,
     LATERAL jsonb_array_elements(snapshot.payload->'phases') AS phase
WHERE phase->>'phase' = 'is_deriving_reports'
ORDER BY snapshot.seq DESC LIMIT 1;
 active | pending 
--------+---------
 false  | true
(1 row)

UPDATE worker.tasks SET state = 'completed' WHERE id = 57702;
UPDATE worker.tasks SET state = 'waiting' WHERE id = 57703;
INSERT INTO worker.tasks (id, command, payload, state, parent_id, depth, priority) VALUES
(57704, 'statistical_unit_facet_reduce', '{"command":"statistical_unit_facet_reduce"}', 'pending', 57703, 2, 4),
(57705, 'statistical_history_facet_delta_reduce', '{"command":"statistical_history_facet_delta_reduce"}', 'pending', 57703, 2, 5);
CALL worker.process_tasks(p_queue => 'analytics', p_batch_size => 2);
SELECT command, reports->>'active' AS active, reports->>'step' AS published_step
FROM handler_observations ORDER BY command;
                command                 | active |             published_step             
----------------------------------------+--------+----------------------------------------
 statistical_history_facet_delta_reduce | true   | statistical_history_facet_delta_reduce
 statistical_unit_facet_reduce          | true   | statistical_unit_facet_reduce
(2 rows)

SELECT command, state FROM worker.tasks ORDER BY id;
                command                 |   state   
----------------------------------------+-----------
 collect_changes                        | completed
 derive_units_phase                     | completed
 derive_reports_phase                   | completed
 statistical_unit_facet_reduce          | completed
 statistical_history_facet_delta_reduce | completed
(5 rows)

SELECT payload->>'type' AS type, payload->>'status' AS status
FROM progress_snapshots ORDER BY seq DESC LIMIT 1;
        type         | status 
---------------------+--------
 is_deriving_reports | false
(1 row)

ROLLBACK;
