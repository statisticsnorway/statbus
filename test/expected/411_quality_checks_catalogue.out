BEGIN;
\i test/setup.sql
\echo -- test/setup.sql output suppressed for cleaner test output
-- test/setup.sql output suppressed for cleaner test output
\set ECHO none
\echo -- test/setup.sql done, test output follows
-- test/setup.sql done, test output follows
-- 05pe0x, h9mhxe: every data-quality check is a row of the catalogue public.quality_check, with an
-- integer id, and its failing units are stored where the check's kind fits.
--
-- public.quality_rule (enum) names the kinds of check. A per-variable rule
-- (public.quality_rule_per_stat) is a check for each summed statistical variable (stat_definition of
-- type int or float); public.in_use(quality_check) says whether it applies now (its variable enabled
-- with lu_es_rollup max). Every other rule is one check. switched_on (1tx1ed) starts off, and a fresh
-- database has the starting set on.
-- A row check's units carry its id in statistical_unit.quality_check_ids, generated from the row. A
-- relation check's units are rows of its own table (public.quality_establishment_activity_differs,
-- public.quality_legal_unit_establishment_stat), filled by worker.derive_quality, with the
-- statistical_unit row's existence dates for counting at an instant.
--
-- The fixture, demo settings (installation country UN), legal units valid from 2020:
--   LU-LESS    employees own 5, establishments 4 + 3            -> establishments above legal unit
--   LU-GAP     employees own 12, establishments 4 + 3            -> legal unit above establishments
--   LU-EQUAL   employees own 9, establishments 5 + 4             -> no comparison finding
--   LU-NOREGION   located in UN without a region                 -> missing region (with its establishment)
--   LU-ABROAD     located in SE without a region                 -> no finding: abroad has no UN region
--   LU-NOWHERE    no physical location                           -> missing physical location
--   LU-DIFFERS    legal unit activity A, primary establishment B -> establishment activity differs
--   LU-SECSAME    legal unit and establishment: primary A, secondary A -> secondary equals primary (both)
--   LU-SECDIFF    legal unit and establishment: primary A, secondary B -> no secondary finding
-- Every unit but LU-DIFFERS, LU-SECSAME, LU-SECDIFF and their establishments has no activity -> missing
-- activity category.
-- A second summed variable 'members' (int) gives LU-LESS a finding for it too; a variable that is
-- not summed, 'listed' (bool), gets no checks.
CALL test.set_user_from_email('test.admin@statbus.org');
\o /dev/null
\set ECHO none
"User selected the Activity Category Standard"
"User uploads the demo activity categories"
"User uploads the demo regions"
"User uploads the demo sectors"
"User uploads the demo legal forms"
SELECT id AS user_id FROM auth.user LIMIT 1 \gset
SELECT id AS active_id FROM public.status WHERE code = 'active' LIMIT 1 \gset
SELECT id AS employees_id FROM public.stat_definition WHERE code = 'employees' \gset
SELECT id AS un_id FROM public.country WHERE iso_2 = 'UN' \gset
SELECT id AS se_id FROM public.country WHERE iso_2 = 'SE' \gset
SELECT id AS region_id FROM public.region ORDER BY path LIMIT 1 \gset
SELECT id AS activity_a_id FROM public.activity_category WHERE enabled ORDER BY path LIMIT 1 \gset
SELECT id AS activity_b_id FROM public.activity_category WHERE enabled ORDER BY path OFFSET 1 LIMIT 1 \gset
SET client_min_messages TO WARNING;
INSERT INTO public.stat_definition (code, type, frequency, name, priority)
VALUES ('members', 'int', 'yearly', 'Members', 30),
       ('listed', 'bool', 'yearly', 'Listed on an exchange', 40);
RESET client_min_messages;
SELECT id AS members_id FROM public.stat_definition WHERE code = 'members' \gset
-- s465ff: the comparison checks apply to a variable whose legal unit total takes the larger level.
SET client_min_messages TO WARNING;
UPDATE public.stat_definition SET lu_es_rollup = 'max' WHERE type IN ('int', 'float');
RESET client_min_messages;
CREATE TEMP TABLE pattern (lu text, own int, est_values int[], members_own int, members_est int[], country text, with_region boolean) ON COMMIT DROP;
INSERT INTO pattern VALUES
    ('LU-LESS',     5,    ARRAY[4, 3],    1,    ARRAY[2, 2], 'UN', true),
    ('LU-GAP',      12,   ARRAY[4, 3],    NULL, NULL,        'UN', true),
    ('LU-EQUAL',    9,    ARRAY[5, 4],    NULL, NULL,        'UN', true),
    ('LU-NOREGION', NULL, ARRAY[1],       NULL, NULL,        'UN', false),
    ('LU-ABROAD',   NULL, ARRAY[1],       NULL, NULL,        'SE', false),
    ('LU-NOWHERE',  NULL, ARRAY[1],       NULL, NULL,        NULL, false),
    ('LU-DIFFERS',  NULL, ARRAY[1],       NULL, NULL,        'UN', true),
    ('LU-SECSAME',  NULL, ARRAY[1],       NULL, NULL,        'UN', true),
    ('LU-SECDIFF',  NULL, ARRAY[1],       NULL, NULL,        'UN', true);
INSERT INTO public.enterprise (short_name, edit_by_user_id, edit_comment)
SELECT 'EN-' || p.lu, :user_id, '05pe0x test enterprise' FROM pattern AS p;
INSERT INTO public.legal_unit (valid_from, name, enterprise_id, primary_for_enterprise, status_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, p.lu, en.id, true, :active_id, :user_id, '05pe0x test legal unit'
FROM pattern AS p JOIN public.enterprise AS en ON en.short_name = 'EN-' || p.lu;
INSERT INTO public.establishment (valid_from, name, legal_unit_id, primary_for_legal_unit, status_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, p.lu || '-es' || e.n, lu.id, e.n = 1, :active_id, :user_id, '05pe0x test establishment'
FROM pattern AS p
JOIN public.legal_unit AS lu ON lu.name = p.lu
CROSS JOIN LATERAL generate_subscripts(p.est_values, 1) AS e(n);
-- Physical locations: the legal unit and its establishments in the pattern's country.
INSERT INTO public.location (valid_from, valid_to, type, address_part1, region_id, country_id, legal_unit_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, 'infinity'::date, 'physical', 'Street 1',
       CASE WHEN p.with_region THEN :region_id END,
       CASE p.country WHEN 'UN' THEN :un_id ELSE :se_id END,
       lu.id, :user_id, '05pe0x test location'
FROM pattern AS p JOIN public.legal_unit AS lu ON lu.name = p.lu
WHERE p.country IS NOT NULL;
INSERT INTO public.location (valid_from, valid_to, type, address_part1, region_id, country_id, establishment_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, 'infinity'::date, 'physical', 'Street 2',
       CASE WHEN p.with_region THEN :region_id END,
       CASE p.country WHEN 'UN' THEN :un_id ELSE :se_id END,
       es.id, :user_id, '05pe0x test location'
FROM pattern AS p
CROSS JOIN LATERAL generate_subscripts(p.est_values, 1) AS e(n)
JOIN public.establishment AS es ON es.name = p.lu || '-es' || e.n
WHERE p.country IS NOT NULL;
-- LU-DIFFERS: the legal unit's primary activity is A, its primary establishment's is B.
INSERT INTO public.activity (valid_from, valid_to, type, category_id, legal_unit_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, 'infinity'::date, 'primary', :activity_a_id, lu.id, :user_id, '05pe0x test activity'
FROM public.legal_unit AS lu WHERE lu.name = 'LU-DIFFERS';
INSERT INTO public.activity (valid_from, valid_to, type, category_id, establishment_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, 'infinity'::date, 'primary', :activity_b_id, es.id, :user_id, '05pe0x test activity'
FROM public.establishment AS es WHERE es.name = 'LU-DIFFERS-es1';
-- qjy2eg: LU-SECSAME's legal unit and establishment have secondary = primary = A; LU-SECDIFF's have
-- primary A and secondary B.
INSERT INTO public.activity (valid_from, valid_to, type, category_id, legal_unit_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, 'infinity'::date, a.type::public.activity_type,
       CASE WHEN lu.name = 'LU-SECDIFF' AND a.type = 'secondary' THEN :activity_b_id ELSE :activity_a_id END,
       lu.id, :user_id, 'qjy2eg test activity'
FROM public.legal_unit AS lu CROSS JOIN (VALUES ('primary'), ('secondary')) AS a(type)
WHERE lu.name IN ('LU-SECSAME', 'LU-SECDIFF');
INSERT INTO public.activity (valid_from, valid_to, type, category_id, establishment_id, edit_by_user_id, edit_comment)
SELECT '2020-01-01'::date, 'infinity'::date, a.type::public.activity_type,
       CASE WHEN es.name = 'LU-SECDIFF-es1' AND a.type = 'secondary' THEN :activity_b_id ELSE :activity_a_id END,
       es.id, :user_id, 'qjy2eg test activity'
FROM public.establishment AS es CROSS JOIN (VALUES ('primary'), ('secondary')) AS a(type)
WHERE es.name IN ('LU-SECSAME-es1', 'LU-SECDIFF-es1');
INSERT INTO public.stat_for_unit (stat_definition_id, valid_from, legal_unit_id, value_int, edit_by_user_id, edit_comment)
SELECT :employees_id, '2020-01-01'::date, lu.id, p.own, :user_id, '05pe0x own value'
FROM pattern AS p JOIN public.legal_unit AS lu ON lu.name = p.lu
WHERE p.own IS NOT NULL
UNION ALL
SELECT :members_id, '2020-01-01'::date, lu.id, p.members_own, :user_id, '05pe0x own value'
FROM pattern AS p JOIN public.legal_unit AS lu ON lu.name = p.lu
WHERE p.members_own IS NOT NULL;
INSERT INTO public.stat_for_unit (stat_definition_id, valid_from, establishment_id, value_int, edit_by_user_id, edit_comment)
SELECT :employees_id, '2020-01-01'::date, es.id, p.est_values[e.n], :user_id, '05pe0x establishment value'
FROM pattern AS p
CROSS JOIN LATERAL generate_subscripts(p.est_values, 1) AS e(n)
JOIN public.establishment AS es ON es.name = p.lu || '-es' || e.n
WHERE p.own IS NOT NULL
UNION ALL
SELECT :members_id, '2020-01-01'::date, es.id, p.members_est[e.n], :user_id, '05pe0x establishment value'
FROM pattern AS p
CROSS JOIN LATERAL generate_subscripts(p.members_est, 1) AS e(n)
JOIN public.establishment AS es ON es.name = p.lu || '-es' || e.n;
CALL worker.process_tasks(p_queue => 'analytics');
-- The fixture's units, by name, for reading findings: enterprises too, so a rule that listed an
-- enterprise would show (every rule lists legal units or establishments only).
CREATE TEMP VIEW fixture_unit AS
SELECT 'legal_unit'::public.statistical_unit_type AS unit_type, lu.id AS unit_id, lu.name
FROM public.legal_unit AS lu WHERE lu.name LIKE 'LU-%'
UNION ALL
SELECT 'establishment', es.id, es.name
FROM public.establishment AS es WHERE es.name LIKE 'LU-%'
UNION ALL
SELECT 'enterprise', en.id, en.short_name
FROM public.enterprise AS en WHERE en.short_name LIKE 'EN-LU-%';
-- Every check's listed statistical_unit rows, from the store of its kind, for reading them all alike.
CREATE TEMP VIEW finding AS
SELECT qc.id AS check_id, qc.rule, qc.stat_definition_id, su.unit_type, su.unit_id, su.valid_range,
       public.existence_from(su) AS existence_from, public.existence_until(su) AS existence_until,
       CASE WHEN qc.rule = 'secondary_activity_equals_primary'
            THEN jsonb_build_object('activity_category_id', su.primary_activity_category_id) END AS detail
FROM public.statistical_unit AS su
JOIN public.quality_check AS qc ON qc.id = ANY (su.quality_check_ids)
UNION ALL
SELECT d.check_id, 'establishment_activity_differs', NULL, d.unit_type, d.unit_id, d.valid_range,
       d.existence_from, d.existence_until,
       jsonb_build_object('legal_unit_activity_category_id', d.legal_unit_activity_category_id,
                          'primary_establishment_id', d.primary_establishment_id,
                          'primary_establishment_activity_category_id', d.establishment_activity_category_id)
FROM public.quality_establishment_activity_differs AS d
UNION ALL
SELECT s.check_id, qc.rule, s.stat_definition_id, s.unit_type, s.unit_id, s.valid_range,
       s.existence_from, s.existence_until,
       jsonb_build_object('legal_unit', s.legal_unit_value, 'establishments_sum', s.establishments_sum,
                          'establishments', s.establishment_count)
FROM public.quality_legal_unit_establishment_stat AS s
JOIN public.quality_check AS qc ON qc.id = s.check_id;
\echo

\echo "411.1 the rules, which are a check per summed statistical variable, and where each kind is stored"
"411.1 the rules, which are a check per summed statistical variable, and where each kind is stored"
SELECT r.rule, public.quality_rule_per_stat(r.rule) AS per_stat, public.quality_rule_kind(r.rule) AS kind
FROM unnest(enum_range(NULL::public.quality_rule)) AS r(rule)
ORDER BY r.rule;
               rule                | per_stat |   kind   
-----------------------------------+----------+----------
 missing_region                    | f        | row
 missing_activity_category         | f        | row
 missing_physical_location         | f        | row
 establishment_activity_differs    | f        | relation
 establishments_above_legal_unit   | t        | relation
 legal_unit_above_establishments   | t        | relation
 secondary_activity_equals_primary | f        | row
(7 rows)

\echo

\echo "411.2 the checks in use: each rule once, each per-variable rule once per enabled summed variable; on a fresh database only the starting set is on (1tx1ed): missing region, missing activity category, secondary activity equals primary"
"411.2 the checks in use: each rule once, each per-variable rule once per enabled summed variable; on a fresh database only the starting set is on (1tx1ed): missing region, missing activity category, secondary activity equals primary"
SELECT qc.id, qc.rule, sd.code AS stat_code, qc.switched_on
FROM public.quality_check AS qc
LEFT JOIN public.stat_definition AS sd ON sd.id = qc.stat_definition_id
WHERE public.in_use(qc)
ORDER BY qc.priority;
 id  |               rule                | stat_code | switched_on 
-----+-----------------------------------+-----------+-------------
   1 | missing_region                    |           | t
   2 | missing_activity_category         |           | t
   3 | missing_physical_location         |           | f
   4 | establishment_activity_differs    |           | f
 101 | establishments_above_legal_unit   | employees | f
 102 | establishments_above_legal_unit   | turnover  | f
 105 | establishments_above_legal_unit   | members   | f
 103 | legal_unit_above_establishments   | employees | f
 104 | legal_unit_above_establishments   | turnover  | f
 106 | legal_unit_above_establishments   | members   | f
   7 | secondary_activity_equals_primary |           | t
(11 rows)

\echo

\echo "411.3 each check's findings on the fixture, with the numbers the per-variable rules compare"
"411.3 each check's findings on the fixture, with the numbers the per-variable rules compare"
SELECT f.rule, sd.code AS stat_code, u.unit_type, u.name,
       CASE WHEN f.rule = 'establishment_activity_differs' THEN NULL
            -- The category is the fixture's A; its id depends on how the seed was built.
            WHEN f.rule = 'secondary_activity_equals_primary'
              THEN jsonb_build_object('activity_category_is_a', (f.detail->>'activity_category_id')::int = :activity_a_id)
            ELSE f.detail END AS compared
FROM finding AS f
JOIN fixture_unit AS u USING (unit_type, unit_id)
LEFT JOIN public.stat_definition AS sd ON sd.id = f.stat_definition_id
ORDER BY f.rule, sd.priority, u.unit_type, u.name;
               rule                | stat_code |   unit_type   |      name       |                             compared                             
-----------------------------------+-----------+---------------+-----------------+------------------------------------------------------------------
 missing_region                    |           | establishment | LU-NOREGION-es1 | 
 missing_region                    |           | legal_unit    | LU-NOREGION     | 
 missing_activity_category         |           | establishment | LU-ABROAD-es1   | 
 missing_activity_category         |           | establishment | LU-EQUAL-es1    | 
 missing_activity_category         |           | establishment | LU-EQUAL-es2    | 
 missing_activity_category         |           | establishment | LU-GAP-es1      | 
 missing_activity_category         |           | establishment | LU-GAP-es2      | 
 missing_activity_category         |           | establishment | LU-LESS-es1     | 
 missing_activity_category         |           | establishment | LU-LESS-es2     | 
 missing_activity_category         |           | establishment | LU-NOREGION-es1 | 
 missing_activity_category         |           | establishment | LU-NOWHERE-es1  | 
 missing_activity_category         |           | legal_unit    | LU-ABROAD       | 
 missing_activity_category         |           | legal_unit    | LU-EQUAL        | 
 missing_activity_category         |           | legal_unit    | LU-GAP          | 
 missing_activity_category         |           | legal_unit    | LU-LESS         | 
 missing_activity_category         |           | legal_unit    | LU-NOREGION     | 
 missing_activity_category         |           | legal_unit    | LU-NOWHERE      | 
 missing_physical_location         |           | establishment | LU-NOWHERE-es1  | 
 missing_physical_location         |           | legal_unit    | LU-NOWHERE      | 
 establishment_activity_differs    |           | legal_unit    | LU-DIFFERS      | 
 establishments_above_legal_unit   | employees | legal_unit    | LU-LESS         | {"legal_unit": 5, "establishments": 2, "establishments_sum": 7}
 establishments_above_legal_unit   | members   | legal_unit    | LU-LESS         | {"legal_unit": 1, "establishments": 2, "establishments_sum": 4}
 legal_unit_above_establishments   | employees | legal_unit    | LU-GAP          | {"legal_unit": 12, "establishments": 2, "establishments_sum": 7}
 secondary_activity_equals_primary |           | establishment | LU-SECSAME-es1  | {"activity_category_is_a": true}
 secondary_activity_equals_primary |           | legal_unit    | LU-SECSAME      | {"activity_category_is_a": true}
(25 rows)

\echo

\echo "411.3b activity differs names the primary establishment and both activities: LU-DIFFERS has A, its establishment B"
"411.3b activity differs names the primary establishment and both activities: LU-DIFFERS has A, its establishment B"
SELECT u.name AS legal_unit,
       es.name AS primary_establishment,
       d.legal_unit_activity_category_id = :activity_a_id AS legal_unit_has_a,
       d.establishment_activity_category_id = :activity_b_id AS establishment_has_b
FROM public.quality_establishment_activity_differs AS d
JOIN fixture_unit AS u USING (unit_type, unit_id)
JOIN public.establishment AS es ON es.id = d.primary_establishment_id;
 legal_unit | primary_establishment | legal_unit_has_a | establishment_has_b 
------------+-----------------------+------------------+---------------------
 LU-DIFFERS | LU-DIFFERS-es1        | t                | t
(1 row)

\echo

\echo "411.3c secondary equals primary lists the legal unit and establishment of LU-SECSAME and not those of LU-SECDIFF"
"411.3c secondary equals primary lists the legal unit and establishment of LU-SECSAME and not those of LU-SECDIFF"
SELECT u.unit_type, u.name,
       EXISTS (SELECT 1 FROM finding AS f
               WHERE f.rule = 'secondary_activity_equals_primary'
                 AND f.unit_type = u.unit_type AND f.unit_id = u.unit_id) AS listed
FROM fixture_unit AS u
WHERE u.name IN ('LU-SECSAME', 'LU-SECSAME-es1', 'LU-SECDIFF', 'LU-SECDIFF-es1')
ORDER BY u.name, u.unit_type;
   unit_type   |      name      | listed 
---------------+----------------+--------
 legal_unit    | LU-SECDIFF     | f
 establishment | LU-SECDIFF-es1 | f
 legal_unit    | LU-SECSAME     | t
 establishment | LU-SECSAME-es1 | t
(4 rows)

\echo

\echo "411.4 a relation finding carries the existence dates of its statistical_unit row"
"411.4 a relation finding carries the existence dates of its statistical_unit row"
SELECT count(*) AS findings,
       count(*) FILTER (WHERE f.existence_from = public.existence_from(su)
                          AND f.existence_until = public.existence_until(su)) AS same_dates
FROM finding AS f
JOIN public.statistical_unit AS su
  ON su.unit_type = f.unit_type AND su.unit_id = f.unit_id AND su.valid_range = f.valid_range
JOIN fixture_unit AS u ON u.unit_type = f.unit_type AND u.unit_id = f.unit_id
WHERE public.quality_rule_kind(f.rule) = 'relation';
 findings | same_dates 
----------+------------
        4 |          4
(1 row)

\echo

\echo "411.5 each check's dashboard count at 2026-05-24 (public.quality_check_count) equals the units public.statistical_unit_quality lists for the search"
"411.5 each check's dashboard count at 2026-05-24 (public.quality_check_count) equals the units public.statistical_unit_quality lists for the search"
SELECT qc.rule, sd.code AS stat_code,
       (SELECT count(*) FROM finding AS f
         JOIN fixture_unit AS u USING (unit_type, unit_id)
         WHERE f.check_id = qc.id
           AND f.existence_from <= '2026-05-24' AND '2026-05-24' < f.existence_until) AS card,
       (SELECT count(*) FROM public.statistical_unit_quality(quality_check_id => qc.id, valid_on => '2026-05-24') AS su
         JOIN fixture_unit AS u ON u.unit_type = su.unit_type AND u.unit_id = su.unit_id) AS list
FROM public.quality_check AS qc
LEFT JOIN public.stat_definition AS sd ON sd.id = qc.stat_definition_id
WHERE public.in_use(qc)
ORDER BY qc.priority;
               rule                | stat_code | card | list 
-----------------------------------+-----------+------+------
 missing_region                    |           |    2 |    2
 missing_activity_category         |           |   15 |   15
 missing_physical_location         |           |    2 |    2
 establishment_activity_differs    |           |    1 |    1
 establishments_above_legal_unit   | employees |    1 |    1
 establishments_above_legal_unit   | turnover  |    0 |    0
 establishments_above_legal_unit   | members   |    1 |    1
 legal_unit_above_establishments   | employees |    1 |    1
 legal_unit_above_establishments   | turnover  |    0 |    0
 legal_unit_above_establishments   | members   |    0 |    0
 secondary_activity_equals_primary |           |    2 |    2
(11 rows)

SELECT count(*) AS checks_in_use,
       count(*) FILTER (WHERE c.units = (SELECT count(*) FROM finding AS f
                                         WHERE f.check_id = c.check_id
                                           AND f.existence_from <= '2026-05-24' AND '2026-05-24' < f.existence_until)) AS same_as_findings
FROM public.quality_check_count(valid_on => '2026-05-24') AS c;
 checks_in_use | same_as_findings 
---------------+------------------
            11 |               11
(1 row)

\echo

\echo "411.6 switching: an admin switches a check on and another off; the others keep their state"
"411.6 switching: an admin switches a check on and another off; the others keep their state"
UPDATE public.quality_check SET switched_on = true WHERE rule = 'legal_unit_above_establishments' AND stat_definition_id = :members_id;
UPDATE public.quality_check SET switched_on = false WHERE rule = 'missing_activity_category';
SELECT qc.rule, sd.code AS stat_code, qc.switched_on
FROM public.quality_check AS qc
LEFT JOIN public.stat_definition AS sd ON sd.id = qc.stat_definition_id
WHERE qc.switched_on
ORDER BY qc.rule;
               rule                | stat_code | switched_on 
-----------------------------------+-----------+-------------
 missing_region                    |           | t
 legal_unit_above_establishments   | members   | t
 secondary_activity_equals_primary |           | t
(3 rows)

\echo "411.6 a switched-off check keeps its findings, so switching it on shows its number at once"
"411.6 a switched-off check keeps its findings, so switching it on shows its number at once"
CALL worker.process_tasks(p_queue => 'analytics');
SELECT count(*) AS missing_activity_findings
FROM finding AS f JOIN fixture_unit AS u USING (unit_type, unit_id)
WHERE f.rule = 'missing_activity_category';
 missing_activity_findings 
---------------------------
                        15
(1 row)

\echo

\echo "411.7 the shape is the database's: a per-variable check needs its variable, no other check has one, and a relation finding names its own check"
"411.7 the shape is the database's: a per-variable check needs its variable, no other check has one, and a relation finding names its own check"
SAVEPOINT before_wrong_shape;
\set ON_ERROR_STOP off
INSERT INTO public.quality_check (rule, stat_definition_id, kind, priority) VALUES ('establishments_above_legal_unit', NULL, 'relation', 1);
ERROR:  new row for relation "quality_check" violates check constraint "quality_check_variable_matches_rule"
ROLLBACK TO SAVEPOINT before_wrong_shape;
INSERT INTO public.quality_check (rule, stat_definition_id, kind, priority) VALUES ('missing_region', :employees_id, 'row', 1);
ERROR:  new row for relation "quality_check" violates check constraint "quality_check_variable_matches_rule"
ROLLBACK TO SAVEPOINT before_wrong_shape;
INSERT INTO public.quality_legal_unit_establishment_stat (check_id, unit_type, unit_id, valid_range, existence_from, existence_until, stat_definition_id, legal_unit_value, establishments_sum, establishment_count)
SELECT qc.id, 'legal_unit', lu.id, daterange('2020-01-01', 'infinity'), '2020-01-01', 'infinity', :employees_id, 12, 7, 2
FROM public.legal_unit AS lu, public.quality_check AS qc
WHERE lu.name = 'LU-GAP' AND qc.rule = 'legal_unit_above_establishments' AND qc.stat_definition_id = :members_id;
ERROR:  insert or update on table "quality_legal_unit_establishment_stat" violates foreign key constraint "quality_legal_unit_establishment_stat_check_fkey"
DETAIL:  Key is not present in table "quality_check".
ROLLBACK TO SAVEPOINT before_wrong_shape;
INSERT INTO public.quality_check (rule, stat_definition_id, kind, priority) VALUES ('missing_region', NULL, 'row', 1);
ERROR:  duplicate key value violates unique constraint "quality_check_rule_variable_key"
ROLLBACK TO SAVEPOINT before_wrong_shape;
\set ON_ERROR_STOP on
\echo "411.7 the four refusals above: two CHECKs on checks, the finding's variable not its check's, and a check entered twice (the unique key)"
"411.7 the four refusals above: two CHECKs on checks, the finding's variable not its check's, and a check entered twice (the unique key)"
SELECT count(*) AS checks FROM public.quality_check;
 checks 
--------
     11
(1 row)

\echo

\echo "411.8 disabling a variable takes its checks out of use; its switch is kept for when it comes back"
"411.8 disabling a variable takes its checks out of use; its switch is kept for when it comes back"
SET client_min_messages TO WARNING;
UPDATE public.stat_definition SET enabled = false WHERE code = 'members';
RESET client_min_messages;
SELECT qc.rule, sd.code AS stat_code, qc.switched_on, public.in_use(qc) AS in_use
FROM public.quality_check AS qc
LEFT JOIN public.stat_definition AS sd ON sd.id = qc.stat_definition_id
WHERE public.quality_rule_per_stat(qc.rule)
ORDER BY qc.rule, sd.priority;
