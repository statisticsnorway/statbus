     '0eb4c45ef880ba5150edc812fbced384f402164c', -- scenario 4's polluted row, STILL wrong (guard)
     '2b3862bccb9716db4bb327b6946f99c25e5efef4'  -- scenario 4's pre-existing correct row, unchanged
 )
