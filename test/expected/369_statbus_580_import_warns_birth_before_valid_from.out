BEGIN;
\i test/setup.sql
\echo -- test/setup.sql output suppressed for cleaner test output
-- test/setup.sql output suppressed for cleaner test output
\set ECHO none
\echo -- test/setup.sql done, test output follows
-- test/setup.sql done, test output follows
\echo "Test 369 (STATBUS-580): the import warns when a unit's timeline starts after its birth date in the same year"
"Test 369 (STATBUS-580): the import warns when a unit's timeline starts after its birth date in the same year"
\echo

\echo "History counts a birth only when a unit's existence starts at its birth_date (STATBUS-558, rule C)."
"History counts a birth only when a unit's existence starts at its birth_date (STATBUS-558, rule C)."
\echo "A unit born 2023-03-01 but first recorded from 2023-05-07 enters the stock in May as added, never as born."
"A unit born 2023-03-01 but first recorded from 2023-05-07 enters the stock in May as added, never as born."
\echo "The import marks such a row with a warning under valid_from_raw, the field to correct: the birth date is"
"The import marks such a row with a warning under valid_from_raw, the field to correct: the birth date is"
\echo "the fact, valid_from should start at it. The row still imports. Only the piece that starts the unit's timeline is warned: a later"
"the fact, valid_from should start at it. The row still imports. Only the piece that starts the unit's timeline is warned: a later"
\echo "piece of the same unit, in the file or already stored, starts after an earlier piece by design."
"piece of the same unit, in the file or already stored, starts after an earlier piece by design."
CALL test.set_user_from_email('test.admin@statbus.org');
\o /dev/null
\set ECHO none
-- ═════════════════════════════════════════════════════════════════════════
-- Part A: legal units, source dates.
-- ═════════════════════════════════════════════════════════════════════════
INSERT INTO public.import_job (definition_id, slug, description, note, edit_comment, review)
SELECT id, 'import_580_lu', 'Test 369 legal units', 'test/data/580_birth_before_valid_from_legal_units.csv', 'Test 369 (STATBUS-580)', false
FROM public.import_definition WHERE slug = 'legal_unit_source_dates';
\copy public.import_580_lu_upload(valid_from,valid_to,tax_ident,name,birth_date,death_date) FROM 'test/data/580_birth_before_valid_from_legal_units.csv' WITH (FORMAT csv, DELIMITER ',', QUOTE '"', HEADER true);
CALL worker.process_tasks(p_queue => 'import');
\echo

\echo "A1 the job finishes and imports every row (a warning does not skip a row):"
"A1 the job finishes and imports every row (a warning does not skip a row):"
SELECT slug, state, total_rows, imported_rows, error IS NOT NULL AS has_job_error
FROM public.import_job WHERE slug = 'import_580_lu';
     slug      |  state   | total_rows | imported_rows | has_job_error 
---------------+----------+------------+---------------+---------------
 import_580_lu | finished |         11 |            11 | f
(1 row)

\echo "A2 every row: state, action and its warnings, key and message"
"A2 every row: state, action and its warnings, key and message"
\echo "   W01 and W10 start their unit's timeline after a birth earlier in the same year: warned."
"   W01 and W10 start their unit's timeline after a birth earlier in the same year: warned."
\echo "   W05 and W06: only the first piece of the unit (W06 regardless of its order in the file)."
"   W05 and W06: only the first piece of the unit (W06 regardless of its order in the file)."
\echo "   W02 born the year before, W03 born on valid_from, W04 born after, W07 no birth date,"
"   W02 born the year before, W03 born on valid_from, W04 born after, W07 no birth date,"
\echo "   W08 exists from its birth: not warned."
"   W08 exists from its birth: not warned."
SELECT dt.row_id, dt.tax_ident_raw, dt.name_raw, dt.valid_from_raw, dt.birth_date_raw, dt.state, dt.action,
       e.key AS warning_key, e.value AS warning
FROM public.import_580_lu_data AS dt
LEFT JOIN LATERAL jsonb_each_text(dt.warnings) AS e(key, value) ON TRUE
ORDER BY dt.row_id, e.key;
 row_id | tax_ident_raw |                  name_raw                  | valid_from_raw | birth_date_raw |   state   | action |  warning_key   |                                                                                                          warning                                                                                                           
--------+---------------+--------------------------------------------+----------------+----------------+-----------+--------+----------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      1 | 573000001     | W01 Born earlier in the year of valid_from | 2023-05-07     | 2023-03-01     | processed | use    | valid_from_raw | After the birth date 2023-03-01 in the same year. If the unit existed from birth, set valid_from to 2023-03-01. Why: history counts the unit as added in May 2023, not as born, so it is missing from the births of 2023.
      2 | 573000002     | W02 Born the year before valid_from        | 2023-05-07     | 2022-11-01     | processed | use    |                | 
      3 | 573000003     | W03 Born on valid_from                     | 2023-05-07     | 2023-05-07     | processed | use    |                | 
      4 | 573000004     | W04 Born after valid_from                  | 2023-05-07     | 2023-06-01     | processed | use    |                | 
      5 | 573000005     | W05 First piece born earlier               | 2023-05-07     | 2023-03-01     | processed | use    | valid_from_raw | After the birth date 2023-03-01 in the same year. If the unit existed from birth, set valid_from to 2023-03-01. Why: history counts the unit as added in May 2023, not as born, so it is missing from the births of 2023.
      6 | 573000005     | W05 Second piece                           | 2023-09-01     | 2023-03-01     | processed | use    |                | 
      7 | 573000006     | W06 Second piece listed first              | 2023-09-01     | 2023-02-01     | processed | use    |                | 
      8 | 573000006     | W06 First piece listed second              | 2023-05-07     | 2023-02-01     | processed | use    | valid_from_raw | After the birth date 2023-02-01 in the same year. If the unit existed from birth, set valid_from to 2023-02-01. Why: history counts the unit as added in May 2023, not as born, so it is missing from the births of 2023.
      9 | 573000007     | W07 No birth date                          | 2023-05-07     |                | processed | use    |                | 
     10 | 573000008     | W08 Exists from birth                      | 2023-03-01     | 2023-03-01     | processed | use    |                | 
     11 | 573000010     | W10 Learned late                           | 2023-06-01     | 2023-03-01     | processed | use    | valid_from_raw | After the birth date 2023-03-01 in the same year. If the unit existed from birth, set valid_from to 2023-03-01. Why: history counts the unit as added in June 2023, not as born, so it is missing from the births of 2023.
(11 rows)

-- ═════════════════════════════════════════════════════════════════════════
-- Part B: a second file. W08 already exists from its birth, so its later piece is not the start of its
-- timeline. W10 gets the missing first piece from its birth date, which is what the warning asks for.
-- ═════════════════════════════════════════════════════════════════════════
INSERT INTO public.import_job (definition_id, slug, description, note, edit_comment, review)
SELECT id, 'import_580_lu_update', 'Test 369 legal units, second file', 'test/data/580_birth_before_valid_from_legal_units_update.csv', 'Test 369 (STATBUS-580)', false
FROM public.import_definition WHERE slug = 'legal_unit_source_dates';
\copy public.import_580_lu_update_upload(valid_from,valid_to,tax_ident,name,birth_date,death_date) FROM 'test/data/580_birth_before_valid_from_legal_units_update.csv' WITH (FORMAT csv, DELIMITER ',', QUOTE '"', HEADER true);
CALL worker.process_tasks(p_queue => 'import');
\echo

\echo "B1 the second job finishes and imports every row:"
"B1 the second job finishes and imports every row:"
SELECT slug, state, total_rows, imported_rows, error IS NOT NULL AS has_job_error
FROM public.import_job WHERE slug = 'import_580_lu_update';
         slug         |  state   | total_rows | imported_rows | has_job_error 
----------------------+----------+------------+---------------+---------------
 import_580_lu_update | finished |          3 |             3 | f
(1 row)

\echo "B2 no row of the second file is warned: W08's piece follows its stored timeline, W09 is born on"
"B2 no row of the second file is warned: W08's piece follows its stored timeline, W09 is born on"
\echo "   valid_from, W10's new first piece starts at its birth date."
"   valid_from, W10's new first piece starts at its birth date."
SELECT dt.row_id, dt.tax_ident_raw, dt.name_raw, dt.valid_from_raw, dt.birth_date_raw, dt.state, dt.action,
       dt.warnings
FROM public.import_580_lu_update_data AS dt
ORDER BY dt.row_id;
 row_id | tax_ident_raw |            name_raw             | valid_from_raw | birth_date_raw |   state   | action | warnings 
--------+---------------+---------------------------------+----------------+----------------+-----------+--------+----------
      1 | 573000008     | W08 Renamed later in the year   | 2023-05-07     | 2023-03-01     | processed | use    | {}
      2 | 573000009     | W09 New in the second file      | 2023-01-01     | 2023-01-01     | processed | use    | {}
      3 | 573000010     | W10 Corrected to start at birth | 2023-03-01     | 2023-03-01     | processed | use    | {}
(3 rows)

CALL worker.process_tasks(p_queue => 'analytics');
\echo

\echo "B3 history for legal units, months of 2023. Added in May: W01, W02, W03, W05, W06, W07 (6); born in May"
"B3 history for legal units, months of 2023. Added in May: W01, W02, W03, W05, W06, W07 (6); born in May"
\echo "   only W03 (born on valid_from). Born in March: W08 and W10 (W10 now starts at its birth date). January: W09."
"   only W03 (born on valid_from). Born in March: W08 and W10 (W10 now starts at its birth date). January: W09."
\echo "   June: W04 born after valid_from (added and born). W01 stays added, not born, until its row is corrected."
"   June: W04 born after valid_from (added and born). W01 stays added, not born, until its row is corrected."
SELECT month, exists_added_count, births
FROM public.statistical_history
WHERE resolution = 'year-month' AND year = 2023 AND unit_type = 'legal_unit'
  AND (exists_added_count <> 0 OR births <> 0)
ORDER BY month;
 month | exists_added_count | births 
-------+--------------------+--------
     1 |                  1 |      1
     3 |                  2 |      2
     5 |                  6 |      1
     6 |                  1 |      1
(4 rows)

-- ═════════════════════════════════════════════════════════════════════════
-- Part C: informal establishments get the same warning.
-- ═════════════════════════════════════════════════════════════════════════
INSERT INTO public.import_job (definition_id, slug, description, note, edit_comment, review)
SELECT id, 'import_580_eswlu', 'Test 369 informal establishments', 'test/data/580_birth_before_valid_from_informal_establishments.csv', 'Test 369 (STATBUS-580)', false
FROM public.import_definition WHERE slug = 'establishment_without_lu_source_dates';
\copy public.import_580_eswlu_upload(valid_from,valid_to,tax_ident,name,birth_date,death_date) FROM 'test/data/580_birth_before_valid_from_informal_establishments.csv' WITH (FORMAT csv, DELIMITER ',', QUOTE '"', HEADER true);
CALL worker.process_tasks(p_queue => 'import');
\echo

\echo "C1 job and rows: E01 warned, E02 not"
"C1 job and rows: E01 warned, E02 not"
SELECT slug, state, total_rows, imported_rows FROM public.import_job WHERE slug = 'import_580_eswlu';
       slug       |  state   | total_rows | imported_rows 
------------------+----------+------------+---------------
 import_580_eswlu | finished |          2 |             2
(1 row)

SELECT dt.row_id, dt.tax_ident_raw, dt.name_raw, dt.state, dt.action, e.key AS warning_key, e.value AS warning
FROM public.import_580_eswlu_data AS dt
LEFT JOIN LATERAL jsonb_each_text(dt.warnings) AS e(key, value) ON TRUE
ORDER BY dt.row_id, e.key;
 row_id | tax_ident_raw |                  name_raw                  |   state   | action |  warning_key   |                                                                                                          warning                                                                                                          
--------+---------------+--------------------------------------------+-----------+--------+----------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      1 | 573100001     | E01 Born earlier in the year of valid_from | processed | use    | valid_from_raw | After the birth date 2023-03-01 in the same year. If the unit existed from birth, set valid_from to 2023-03-01. Why: history counts the unit as added in May 2023, not as born, so it is missing from the births of 2023.
      2 | 573100002     | E02 Born on valid_from                     | processed | use    |                | 
(2 rows)

ROLLBACK;
