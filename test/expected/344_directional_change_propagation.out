\echo "--- TEST I: PR change (custom_root override, should spawn PG-only batch) ---"
"--- TEST I: PR change (custom_root override, should spawn PG-only batch) ---"
--------------------------------------------------------------------------------
-- The demo LR data has only simple trees (1 natural root per PG), so
-- process_power_group_link creates 0 power_root rows.  We need a cycle
-- (0 natural roots) to produce power_root rows for testing.
-- Create two fresh LUs with a mutual ownership cycle (A->B, B->A).
\echo "Step 1: Import two new LUs for cycle test"
"Step 1: Import two new LUs for cycle test"
INSERT INTO public.import_job (definition_id, slug, description, note, edit_comment, time_context_ident)
SELECT
    (SELECT id FROM public.import_definition WHERE slug = 'legal_unit_job_provided'),
    'import_44_lu_cycle',
    'Import cycle LUs (344)',
    'Cycle LUs',
    'Test 344 cycle',
    'r_year_curr';
\copy public.import_44_lu_cycle_upload(tax_ident,stat_ident,name,birth_date,physical_region_code,physical_country_iso_2,primary_activity_category_code,legal_form_code,sector_code,employees,turnover,data_source_code) FROM stdin WITH (FORMAT csv, DELIMITER ',', QUOTE '"', HEADER true)
\echo "Step 2: Import mutual LRs to create cycle (A->B and B->A)"
"Step 2: Import mutual LRs to create cycle (A->B and B->A)"
INSERT INTO public.import_job (definition_id, slug, description, note, edit_comment, time_context_ident)
SELECT
    (SELECT id FROM public.import_definition WHERE slug = 'legal_relationship_job_provided'),
    'import_44_lr_cycle',
    'Import cycle LRs (344)',
    'Cycle LRs',
    'Test 344 cycle',
    'r_year_curr';
\copy public.import_44_lr_cycle_upload(influencing_tax_ident,influenced_tax_ident,rel_type_code,percentage) FROM stdin WITH (FORMAT csv, DELIMITER ',', QUOTE '"', HEADER true)
\echo "Step 3: Process imports and analytics"
"Step 3: Process imports and analytics"
CALL worker.process_tasks(p_queue => 'import');
CALL worker.process_tasks(p_queue => 'analytics');
DELETE FROM worker.tasks WHERE state = 'completed';
\echo "Check: power_root rows exist after cycle creation"
"Check: power_root rows exist after cycle creation"
SELECT count(*) AS pr_count FROM public.power_root;
 pr_count 
----------
        1
(1 row)

\echo "Action: Setting custom_root on a power_root row (NSO override)"
"Action: Setting custom_root on a power_root row (NSO override)"
UPDATE public.power_root
SET custom_root_legal_unit_id = derived_root_legal_unit_id
WHERE id = (SELECT id FROM public.power_root ORDER BY id LIMIT 1);
\echo "Check: Expect one collect_changes task"
"Check: Expect one collect_changes task"
SELECT command, state FROM worker.tasks WHERE command = 'collect_changes' AND state = 'pending';
     command     |  state  
-----------------+---------
 collect_changes | pending
(1 row)

\echo "Run analytics worker"
"Run analytics worker"
CALL worker.process_tasks(p_queue => 'analytics');
\echo "Task payload: PG batch should have power_group_ids but no enterprise_ids"
"Task payload: PG batch should have power_group_ids but no enterprise_ids"
SELECT
    payload ? 'power_group_ids' AS has_pg_ids,
    payload ? 'enterprise_ids' AS has_ent_ids
FROM worker.tasks
WHERE command = 'statistical_unit_refresh_batch'
  AND state = 'completed'
  AND payload ? 'power_group_ids' AND NOT (payload ? 'enterprise_ids')
ORDER BY id DESC LIMIT 1;
 has_pg_ids | has_ent_ids 
------------+-------------
 t          | f
(1 row)

\echo "Clean up for next test"
"Clean up for next test"
DELETE FROM worker.tasks WHERE state = 'completed';
--------------------------------------------------------------------------------
\echo "--- TEST J: LU migration between enterprises (connect_legal_unit_to_enterprise) ---"
"--- TEST J: LU migration between enterprises (connect_legal_unit_to_enterprise) ---"
--------------------------------------------------------------------------------
-- Moving a LU between enterprises should propagate changes to both old and new EN.
\echo "Step 1: Identify two LUs in different enterprises"
"Step 1: Identify two LUs in different enterprises"
-- Capture the source and target identities before the move. Enterprise IDs are
-- allocated by import execution, while this transition follows the same LUs.
CREATE TEMP TABLE t344_move ON COMMIT DROP AS
SELECT lu.id AS source_lu_id, lu.name AS source_name,
       lu.enterprise_id AS source_enterprise_id,
       target.id AS target_lu_id, target.name AS target_name,
       target.enterprise_id AS target_enterprise_id
FROM public.legal_unit AS lu
CROSS JOIN LATERAL (
    SELECT lu2.id, lu2.name, lu2.enterprise_id
    FROM public.legal_unit AS lu2
    WHERE lu2.enterprise_id != lu.enterprise_id
      AND lu2.valid_from <= current_date AND current_date < lu2.valid_until
    ORDER BY lu2.id LIMIT 1
) AS target
WHERE lu.name = 'SSB Updated'
  AND lu.valid_from <= current_date AND current_date < lu.valid_until;
SELECT move.source_name, move.target_name,
       source_en.short_name = 'SSB-EN' AS source_is_ssb_en,
       move.source_enterprise_id != move.target_enterprise_id AS different_enterprises
FROM t344_move AS move
JOIN public.enterprise AS source_en ON source_en.id = move.source_enterprise_id;
 source_name |   target_name    | source_is_ssb_en | different_enterprises 
-------------+------------------+------------------+-----------------------
 SSB Updated | NILE PEARL WATER | t                | t
(1 row)

-- Drop leftover temp tables from temporal_merge (created by SECURITY DEFINER
-- import functions as postgres; current role can't drop them)
RESET ROLE;
DROP TABLE IF EXISTS pg_temp.temporal_merge_plan;
DROP TABLE IF EXISTS pg_temp.temporal_merge_feedback;
DROP TABLE IF EXISTS pg_temp.temporal_merge_entity_id_map;
NOTICE:  table "temporal_merge_entity_id_map" does not exist, skipping
DROP TABLE IF EXISTS pg_temp.temporal_merge_index_cache;
CALL test.set_user_from_email('test.admin@statbus.org');
\echo "Step 2: Move SSB Updated to the target enterprise"
"Step 2: Move SSB Updated to the target enterprise"
CREATE TEMP TABLE t344_connect_response ON COMMIT DROP AS
SELECT connect_legal_unit_to_enterprise(
    legal_unit_id => move.source_lu_id,
    enterprise_id => move.target_enterprise_id
) AS response
FROM t344_move AS move;
-- Assert the exact API keys and their actual captured identities, including
-- the unchanged source enterprise and the precise LU membership being moved.
WITH expected_response AS (
    SELECT jsonb_build_object(
        'new_enterprise_id', move.target_enterprise_id,
        'old_enterprise_id', move.source_enterprise_id,
        'deleted_enterprise_id', NULL,
        'updated_legal_unit_ids', ARRAY[move.source_lu_id]
    ) AS response
    FROM t344_move AS move
)
SELECT COALESCE(actual.key, expected.key) AS response_key,
       actual.value = expected.value AS matches_transition
FROM (SELECT entry.* FROM t344_connect_response AS result,
      LATERAL jsonb_each(result.response) AS entry) AS actual
FULL JOIN (SELECT entry.* FROM expected_response AS result,
           LATERAL jsonb_each(result.response) AS entry) AS expected USING (key)
ORDER BY response_key;
      response_key      | matches_transition 
------------------------+--------------------
 deleted_enterprise_id  | t
 new_enterprise_id      | t
 old_enterprise_id      | t
 updated_legal_unit_ids | t
(4 rows)

\echo "Check: Expect one collect_changes task"
"Check: Expect one collect_changes task"
SELECT command, state FROM worker.tasks WHERE command = 'collect_changes' AND state = 'pending';
     command     |  state  
-----------------+---------
 collect_changes | pending
(1 row)

\echo "Run analytics worker"
"Run analytics worker"
CALL worker.process_tasks(p_queue => 'analytics');
\echo "Task payload: should have changed_lu and changed_en ranges (LU moved between enterprises)"
"Task payload: should have changed_lu and changed_en ranges (LU moved between enterprises)"
SELECT
    payload->>'changed_establishment_id_ranges' AS changed_est,
    CASE WHEN (payload->>'changed_legal_unit_id_ranges')::int4multirange <> '{}'::int4multirange THEN 'has_ranges' END AS changed_lu,
    CASE WHEN (payload->>'changed_enterprise_id_ranges')::int4multirange <> '{}'::int4multirange THEN 'has_ranges' END AS changed_en
FROM worker.tasks
WHERE command = 'statistical_unit_refresh_batch'
  AND state = 'completed'
  AND payload ? 'enterprise_ids'
ORDER BY id DESC LIMIT 1;
 changed_est | changed_lu | changed_en 
-------------+------------+------------
 {}          | has_ranges | has_ranges
(1 row)

\echo "Verify: SSB Updated and both enterprise identities were propagated"
"Verify: SSB Updated and both enterprise identities were propagated"
SELECT
    (task.payload->>'changed_legal_unit_id_ranges')::int4multirange @> move.source_lu_id AS moved_lu,
    (task.payload->>'changed_enterprise_id_ranges')::int4multirange @> move.source_enterprise_id AS source_enterprise,
    (task.payload->>'changed_enterprise_id_ranges')::int4multirange @> move.target_enterprise_id AS target_enterprise
FROM t344_move AS move
CROSS JOIN LATERAL (
    SELECT payload FROM worker.tasks
    WHERE command = 'statistical_unit_refresh_batch'
      AND state = 'completed' AND payload ? 'enterprise_ids'
    ORDER BY id DESC LIMIT 1
) AS task;
 moved_lu | source_enterprise | target_enterprise 
----------+-------------------+-------------------
 t        | t                 | t
(1 row)

\echo "Verify: current LU and enterprise analytics contain the captured target membership"
"Verify: current LU and enterprise analytics contain the captured target membership"
SELECT lu.name,
       lu.enterprise_id = move.target_enterprise_id AS target_membership,
       target_lu.enterprise_id = move.target_enterprise_id AS target_lu_retained,
       su.related_enterprise_ids @> ARRAY[move.target_enterprise_id] AS lu_analytics,
       target_su.related_legal_unit_ids @> ARRAY[move.source_lu_id, move.target_lu_id] AS enterprise_analytics
FROM t344_move AS move
JOIN public.legal_unit AS lu ON lu.id = move.source_lu_id
JOIN public.legal_unit AS target_lu ON target_lu.id = move.target_lu_id
JOIN public.statistical_unit AS su ON su.unit_type = 'legal_unit' AND su.unit_id = lu.id
JOIN public.statistical_unit AS target_su ON target_su.unit_type = 'enterprise'
    AND target_su.unit_id = move.target_enterprise_id
WHERE lu.valid_from <= current_date AND current_date < lu.valid_until
  AND target_lu.valid_from <= current_date AND current_date < target_lu.valid_until
  AND su.valid_from <= current_date AND current_date < su.valid_until
  AND target_su.valid_from <= current_date AND current_date < target_su.valid_until;
    name     | target_membership | target_lu_retained | lu_analytics | enterprise_analytics 
-------------+-------------------+--------------------+--------------+----------------------
 SSB Updated | t                 | t                  | t            | t
(1 row)

\echo "Verify: SSB Updated now in new enterprise (no longer in the SSB-EN enterprise)"
"Verify: SSB Updated now in new enterprise (no longer in the SSB-EN enterprise)"
SELECT lu.name, lu.enterprise_id != (SELECT en.id FROM public.enterprise AS en WHERE en.short_name = 'SSB-EN') AS moved_away
FROM public.legal_unit AS lu
WHERE lu.name = 'SSB Updated'
  AND lu.valid_from <= current_date AND current_date < lu.valid_until;
    name     | moved_away 
-------------+------------
 SSB Updated | t
(1 row)

