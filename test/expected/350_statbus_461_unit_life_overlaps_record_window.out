CALL worker.process_tasks(p_queue => 'analytics');
\echo "A5 target table: legal_unit rows per identifier in statistical_unit (0 = absent)"
"A5 target table: legal_unit rows per identifier in statistical_unit (0 = absent)"
SELECT ids.tax_ident,
       ids.expectation,
       count(su.unit_id) AS statistical_unit_rows,
       string_agg(su.valid_from || '..' || su.valid_to
                  || ' born ' || COALESCE(su.birth_date::text, '-')
                  || ' died ' || COALESCE(su.death_date::text, '-'), '; ' ORDER BY su.valid_from) AS slices
FROM (VALUES
    ('461000001', 'C01 reject'),
    ('461000002', 'C02 reject'),
    ('461000003', 'C03 reject'),
    ('461000004', 'C04 reject'),
    ('461000005', 'C05 reject'),
    ('461000006', 'C06 accept'),
    ('461000007', 'C07 accept'),
    ('461000008', 'C08 accept'),
    ('461000009', 'C09 accept'),
    ('461000010', 'C10a accept'),
    ('461000011', 'C10b reject'),
    ('461000012', 'C11a accept'),
    ('461000013', 'C11b reject'),
    ('461000014', 'C12 accept'),
    ('461000015', 'C13 accept'),
    ('461000016', 'C14a 2023 reject, 2024 accept'),
    ('461000017', 'C14b 2023 accept, 2024 reject'),
    ('461000018', 'C14c 2024 accept, 2023 reject'),
    ('461000019', 'C15 reject (valid_time)')
) AS ids(tax_ident, expectation)
LEFT JOIN public.statistical_unit AS su
       ON su.unit_type = 'legal_unit' AND su.external_idents->>'tax_ident' = ids.tax_ident
GROUP BY ids.tax_ident, ids.expectation
ORDER BY ids.tax_ident;
 tax_ident |          expectation          | statistical_unit_rows |                         slices                         
-----------+-------------------------------+-----------------------+--------------------------------------------------------
 461000001 | C01 reject                    |                     0 | 
 461000002 | C02 reject                    |                     0 | 
 461000003 | C03 reject                    |                     0 | 
 461000004 | C04 reject                    |                     0 | 
 461000005 | C05 reject                    |                     0 | 
 461000006 | C06 accept                    |                     1 | 2024-01-01..infinity born 2024-11-01 died -
 461000007 | C07 accept                    |                     1 | 2023-01-01..2023-12-31 born 2023-01-01 died -
 461000008 | C08 accept                    |                     1 | 2023-01-01..2023-12-31 born 2020-01-01 died 2023-06-30
 461000009 | C09 accept                    |                     1 | 2023-01-01..2023-12-31 born - died 2024-01-01
 461000010 | C10a accept                   |                     1 | 2023-01-01..2023-12-31 born 2023-12-31 died -
 461000011 | C10b reject                   |                     0 | 
 461000012 | C11a accept                   |                     1 | 2023-01-01..2023-12-31 born - died 2023-01-02
 461000013 | C11b reject                   |                     0 | 
 461000014 | C12 accept                    |                     1 | 2023-01-01..infinity born - died -
 461000015 | C13 accept                    |                     1 | 2023-01-01..infinity born 2024-11-01 died -
 461000016 | C14a 2023 reject, 2024 accept |                     1 | 2024-01-01..infinity born 2024-11-01 died -
 461000017 | C14b 2023 accept, 2024 reject |                     1 | 2023-01-01..2023-12-31 born 2020-01-01 died -
 461000018 | C14c 2024 accept, 2023 reject |                     1 | 2024-01-01..infinity born 2024-11-01 died -
 461000019 | C15 reject (valid_time)       |                     0 | 
(19 rows)

