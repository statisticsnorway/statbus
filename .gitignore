# STATBUS .gitignore. Project-specific and root-anchored where it matters.
# The inherited gitignore.io node/csharp/visualstudio boilerplate that used to
# live here was removed (STATBUS-352): there is no .NET build, and its
# unanchored rules ([Rr]elease/, [Bb]in/, ...) silently swallowed real source
# three times. cli/internal/invariants pins that no Go package directory is
# ever gitignored.

### Python helper scripts (samples/, test/) ###
__pycache__/
*.pyc

### Node / Next.js (app/) ###
*.log
npm-debug.log*
node_modules
.eslintcache
*.tgz
app/.next
.parcel-cache/**
parcel-trace-*.json
coverage
.nyc_output

### Editors and OS ###
.idea/
# Office lock files
~$*
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
app/.vscode/*
!app/.vscode/settings.json
!app/.vscode/tasks.json
!app/.vscode/launch.json
**/.DS_Store

### Secrets and local config ###
*.tmp
.env-dev.statbus.org.sh
.env
.env.config
.env.backup*
.env.credentials
.env.local
.users.yml
key-*.xml
uploads

# Caddy data directory (ACME certs, custom certs, private keys)
/caddy/data/

### Scratch directories for AI tools and diagnostic scripts (pre-commit hook also blocks) ###
tmp/
!tmp/.gitkeep
app/tmp/
!app/tmp/.gitkeep

# AI tool files, except those useful.
.aider*
!.aider.conf.yml
!.aiderignore
# Claude Code: ignore local settings, but keep rules (committed conventions)
.claude/settings.local.json
.claude/todos.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/team.name
# jcode project-local config (per-machine, not shared)
.jcode/

### Migration seeds (large binary dumps and list files, generated locally) ###
migrations/seeds/*.pg_dump
migrations/seeds/*.pg_list
!migrations/seeds/.gitkeep

### Database dumps for debugging (large binary files) ###
dbdumps/*.pg_dump
!dbdumps/.gitkeep

### Go CLI binary (built from cli/ to repo root) ###
/sb
/sb.old
/sb.new
/sb-*
cli/dist/
# Certificates are never committed, except the test fixtures
# (cli/cmd/testdata/*.pfx) that exercise the ./sb cert install PFX decode
# path. See the regeneration recipe at the top of cli/cmd/cert_test.go.
*.pfx
!cli/cmd/testdata/*.pfx

### DB seed cache — fetched from origin/db-seed branch on first dev.sh run ###
# Intent: speeds up create-db from ~294 migrations to one pg_restore (~2 seconds)
/.db-seed/
# Legacy directory name (pre-rc.66 rename); kept ignored so a workspace
# carrying the old layout doesn't accidentally commit it during the transition.
/.db-snapshot/

### Generated by ./sb config generate from ADMINISTRATOR_CONTACT in .env.config ###
ops/maintenance/contact.js
