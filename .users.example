# Seed users for the first install. Afterwards, users are managed in the application.
# Editing this file does nothing by itself. Run ./sb users create to apply ADDITIONS.
# Existing users are not updated from this file.

- display_name: Admin User
  email: admin@example.com
  password: adminSecret123
  role: admin_user
- display_name: Regular User
  email: user@example.com
  password: userSecret456
  role: regular_user
- display_name: Restricted User
  email: restricted@example.com
  password: restrictedSecret789
  role: restricted_user
- display_name: External User
  email: external@example.com
  password: externalSecret012
  role: external_user
